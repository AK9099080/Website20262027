// wrangler.jsonc — configure Cloudflare Workers to deploy static site assets
{
  // Must match your existing Worker name in Cloudflare
  "name": "tsa-web",

  // Entry point (static HTML served directly)
  "main": "index.html",

  // Compatibility date for the Workers runtime
  "compatibility_date": "2026-11-20",

  // Deploy all static files in the repo root as assets
  "assets": {
    "directory": "./",
    "include": [
      "index.html",
      "about.html",
      "references.html",
      "stats.html",
      "news.html",
      "dash.html",
      "lib.html",
      "games.html",
      "lb.html",
      "me.html",
      "404.html",
      "style.css",
      "app.js",
      "img/**"
    ],
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".gitignore",
      "wrangler.jsonc"
    ]
  }
}
